<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.SnowTrail" parent="Theme.AppCompat.Light.NoActionBar">
        <item name="android:windowBackground">@android:color/white</item>
        <item name="android:statusBarColor">#EF9A9A</item>
    </style>

    <style name="MainActivityTheme.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">#EF9A9A</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/splash_icon</item>
        <item name="postSplashScreenTheme">@style/Theme.SnowTrail</item>
    </style>
</resources>